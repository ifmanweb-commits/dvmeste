generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//metaData: {
//  "secretCatalog": {
//    "optIn": true,
//    "freeSessions": 1,
//    "price": 3000,
//  }
//}
model User {
  id                    String               @id @default(cuid())
  /// @encrypted
  email                 String               @unique
  emailVerified         DateTime?
  fullName              String?
  firstName             String?              // Имя (генерируется в fullName как "Фамилия Имя")
  lastName              String?              // Фамилия
  middleName            String?              // Отчество (опционально, не включается в fullName)
  isAdmin               Boolean              @default(false)
  isManager             Boolean              @default(false)
  status                PsychologistStatus   @default(PENDING)
  isPublished           Boolean              @default(false)
  wantPublished         Boolean              @default(true)
  metaData              Json                 @default("{}") @db.Json
  slug                  String?              @unique
  gender                String?
  birthDate             DateTime?
  city                  String?
  workFormat            String?
  mainParadigm          String[]
  certificationLevel    Int                  @default(0)
  firstDiplomaDate      DateTime?
  lastCertificationDate DateTime?
  shortBio              String?              @db.VarChar(400)
  longBio               String?
  price                 Int?
  contactInfo           String?              @db.VarChar(150)
  unsubscribed          Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  draftData             Json?                @default("{}") @db.Json
  hasUnpublishedChanges Boolean              @default(false)
  avatarUrl             String?
  freeSession           Int                  @default(0)
  emailHash             String?              @unique
  isSupervisor          Boolean              @default(false)
  sortOrder             Int                  @default(0)
  showCandidate         Boolean              @default(false)
  balance               Int                  @default(0)
  totalBonus            Int                  @default(0)
  moderatedArticles     Article[]            @relation("ModeratedArticles")
  articles              Article[]            @relation("AuthorArticles")
  certificationAwards   CertificationAward[] @relation("CertificationAwards")
  challengeAttempts     ChallengeAttempt[]   @relation("UserChallengeAttempts")
  challengeStates       ChallengeUserState[] @relation("UserChallengeStates")
  complaintsFrom        Complaint[]          @relation("psychologist_complaints_from")
  complaintsTo          Complaint[]          @relation("psychologist_complaints_to")
  courseKeys            CourseKeyUse[]
  dialogs               Dialog?
  documents             Document[]           @relation("user_documents")
  verifiedDocuments     Document[]           @relation("verifier_documents")
  leads                 Lead[]
  lessonCompletions     LessonCompletion[]   @relation("UserLessonCompletions")
  moderatorRecords      ModerationRecord[]   @relation("moderator_records")
  moderationRecords     ModerationRecord[]   @relation("moderated_user")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  sessions              Session[]
  transactions          Transaction[]
  courses               UserCourse[]
  tipDismissals         UserTipDismissal[]
  workReviews           WorkReview[]         @relation("SupervisorWorkReviews")
  reviewedSubmissions   WorkSubmission[]     @relation("ReviewerWorkSubmissions")
  workSubmissions       WorkSubmission[]     @relation("UserWorkSubmissions")
  questionnaireReviews  QuestionnaireReview[] @relation("SupervisorQuestionnaireReviews")
  reviewedQuestionnaireSubmissions QuestionnaireSubmission[] @relation("ReviewerQuestionnaireSubmissions")
  questionnaireSubmissions QuestionnaireSubmission[] @relation("UserQuestionnaireSubmissions")
  keyUses               KeyUse[]
  certificates          Certificate[] @relation("UserCertificates")
  withdrawalRequests    WithdrawalRequest[] @relation("user_withdrawal_requests")
  moderatedWithdrawals  WithdrawalRequest[] @relation("moderator_withdrawals")
  accessLogs            AccessLog[]
  
  // Consent fields
  consentGivenAt   DateTime?   // дата согласия
  consentVersion   String?     // версия документа ("1.0", "2.0")
  consentIp        String?     // IP при согласии
  consentUserAgent String?     // браузер/устройство
  
  // Payment relations
  payments         Payment[]
  paymentLinks     PaymentLink[]

  @@index([email])
  @@index([status])
  @@index([isPublished])
  @@index([city])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String?   // для психологов
  clientId     String?   // для клиентов
  expires      DateTime
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
  @@index([clientId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  metadata   String?  @db.Text

  @@unique([identifier, token])
  @@index([expires])
}

model Article {
  id               String           @id @default(cuid())
  title            String
  content          String
  excerpt          String?
  slug             String           @unique
  image            String?
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  userId           String?
  moderatedAt      DateTime?
  moderatedBy      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tags             String[]         @default([])
  moderatorComment String?
  submittedAt      DateTime?
  moderationStatus ModerationStatus @default(DRAFT)
  bonusPoints      Int              @default(0)
  moderator        User?            @relation("ModeratedArticles", fields: [moderatedBy], references: [id])
  user             User?            @relation("AuthorArticles", fields: [userId], references: [id])
  articleImages    ArticleImage[]

  @@index([userId])
  @@index([moderationStatus])
  @@index([isPublished])
}

model ArticleImage {
  id          String   @id @default(cuid())
  articleId   String
  url         String
  storagePath String
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  url          String
  filename     String
  mimeType     String
  size         Int
  description  String?
  userId       String
  verifiedAt   DateTime?
  verifiedBy   String?
  uploadedAt   DateTime     @default(now())
  organization String?
  programName  String?
  year         Int?
  user         User         @relation("user_documents", fields: [userId], references: [id], onDelete: Cascade)
  verifier     User?        @relation("verifier_documents", fields: [verifiedBy], references: [id])

  @@index([userId])
  @@index([type])
  @@index([verifiedAt])
}

model Blocks {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  content     String?
  description String?
  isActive    Boolean @default(true)
  
  // Новые поля для системы блоков
  isScript    Boolean @default(false)  // true = JavaScript-скрипт, false = обычный HTML
  inHead      Boolean @default(false)  // true = вставляется в <head>, false = в тело страницы
  order       Int     @default(0)      // Порядок вывода на сайте
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ModerationRecord {
  id          String           @id @default(cuid())
  status      ModerationStatus
  comment     String?
  userId      String
  moderatorId String?
  createdAt   DateTime         @default(now())
  moderator   User?            @relation("moderator_records", fields: [moderatorId], references: [id])
  user        User             @relation("moderated_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([moderatorId])
}

model Dialog {
  id            String       @id @default(cuid())
  userId        String       @unique
  status        DialogStatus @default(ACTIVE)
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
}

model Message {
  id        String   @id @default(cuid())
  direction String
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  dialogId  String
  dialog    Dialog   @relation(fields: [dialogId], references: [id], onDelete: Cascade)

  @@index([dialogId])
  @@index([createdAt])
}

// Возможные значения поля template:
// - "blank" — Пустая страница, только контент без обёртки LayoutShell
// - "landing" — Лендинг с обёрткой LayoutShell, без заголовка
// - "text" — Текстовая страница с обёрткой LayoutShell, заголовком и стилями prose
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  adminTitle      String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  metaRobots      String?
  template        String   // blank, landing, text
  content         String
  customHead      String?
  images          String[]
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model DataList {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  items     Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  linkUrl    String?
  linkText   String?
  isRead     Boolean          @default(false)
  isArchived Boolean          @default(false)
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  metadata   Json?            @default("{}")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  browser    String?
  deviceOs   String?
  deviceType String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id             String      @id @default(cuid())
  email          String      @unique
  emailVerified  DateTime?
  emailHash      String?     @unique
  name           String?
  phone          String?
  vk             String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  complaintCount Int         @default(0)
  isShadowBanned Boolean     @default(false)
  
  // Consent fields
  consentGivenAt   DateTime?   // дата согласия
  consentVersion   String?     // версия документа ("1.0", "2.0")
  consentIp        String?     // IP при согласии
  consentUserAgent String?     // браузер/устройство
  
  complaintsFrom Complaint[] @relation("client_complaints_from")
  complaintsTo   Complaint[] @relation("client_complaints_to")
  leads          Lead[]
  sessions       Session[]
  accessLogs     AccessLog[]

  @@index([email])
  @@index([emailHash])
}

model Lead {
  id               String          @id @default(cuid())
  clientId         String
  psychologistId   String
  message          String?
  status           LeadStatus      @default(NEW)
  statusChangedAt  DateTime?
  createdAt        DateTime        @default(now())
  viewedAt         DateTime?
  isSuspicious     Boolean         @default(false)
  suspiciousReason String?
  ipAddress        String?
  resolution       LeadResolution?
  complaints       Complaint[]
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psychologist     User            @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([psychologistId])
  @@index([status])
  @@index([createdAt])
}

model Complaint {
  id                 String    @id @default(cuid())
  fromType           String
  fromClientId       String?
  fromPsychologistId String?
  toClientId         String?
  toPsychologistId   String?
  reason             String
  description        String?
  leadId             String?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedBy         String?
  resolution         String?
  fromClient         Client?   @relation("client_complaints_from", fields: [fromClientId], references: [id])
  fromPsychologist   User?     @relation("psychologist_complaints_from", fields: [fromPsychologistId], references: [id])
  lead               Lead?     @relation(fields: [leadId], references: [id])
  toClient           Client?   @relation("client_complaints_to", fields: [toClientId], references: [id])
  toPsychologist     User?     @relation("psychologist_complaints_to", fields: [toPsychologistId], references: [id])

  @@index([fromType])
  @@index([toClientId])
  @@index([toPsychologistId])
  @@index([createdAt])
}

model Course {
  id              String                  @id @default(cuid())
  slug            String                  @unique
  title           String
  shortTitle      String
  description     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  challengeAccess CourseChallengeAccess[]
  keys            CourseKey[]
  enrollments     UserCourse[]

  @@index([slug])
}

model UserCourse {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  status     String
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model CourseKey {
  id        String         @id @default(cuid())
  courseId  String
  key       String         @unique
  status    String
  maxUses   Int            @default(1)
  usedCount Int            @default(0)
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uses      CourseKeyUse[]

  @@index([key])
  @@index([courseId])
}

model CourseKeyUse {
  id     String    @id @default(cuid())
  keyId  String
  userId String
  usedAt DateTime  @default(now())
  key    CourseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyId])
  @@index([userId])
}

model CourseChallengeAccess {
  id          String    @id @default(cuid())
  courseId    String
  challengeId String
  status      String
  order       Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, challengeId, status])
  @@index([courseId])
  @@index([challengeId])
}

model Challenge {
  id                String                     @id @default(cuid())
  slug              String                     @unique
  title             String
  description       String?
  type              ChallengeType
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  price             Int?
  requirements      CertificationRequirement[]
  attempts          ChallengeAttempt[]
  userStates        ChallengeUserState[]
  courseAccess      CourseChallengeAccess[]
  lesson            LessonChallenge?
  lessonCompletions LessonCompletion[]         @relation("ChallengeLessonCompletions")
  test              TestChallenge?
  work              WorkChallenge?
  workSubmissions   WorkSubmission[]
  questionnaire     QuestionnaireChallenge?
  questionnaireSubmissions QuestionnaireSubmission[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
}

model TestChallenge {
  id             String    @id @default(cuid())
  challengeId    String    @unique
  questionsPool  Json
  questionsCount Int
  passingScore   Int
  timeLimit      Int?
  freeAttempts   Int       @default(2)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model WorkChallenge {
  id              String    @id @default(cuid())
  challengeId     String    @unique
  instructions    String?   @db.Text  // инструкция для супервизора
  requiredReviews Int       @default(1)
  reviewsToPass   Int       @default(1)
  reviewPrice     Int?      // цена проверки (в копейках)
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model QuestionnaireChallenge {
  id                      String    @id @default(cuid())
  challengeId             String    @unique
  questionsPool           Json      // массив вопросов (строки)
  timeLimit               Int?      // время в минутах
  reviewPrice             Int?      // цена проверки для супервизора (в копейках)
  requiredReviews         Int       @default(1)
  reviewsToPass           Int       @default(1)
  questionsCount          Int       @default(5) // сколько вопросов будет задано в попытке
  instructionsForPsychologist String? @db.Text  // инструкция для психолога
  instructionsForSupervisor   String? @db.Text  // инструкция для супервизора
  challenge               Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model QuestionnaireSubmission {
  id            String                 @id @default(cuid())
  challengeId   String
  userId        String
  answers       Json                   // массив объектов { questionIndex, answer }
  status        QuestionnaireStatus    @default(SUBMITTED)
  startedAt     DateTime               @default(now()) // время начала заполнения
  submittedAt   DateTime               @default(now())
  reviewerId    String?
  approvedCount Int                    @default(0)
  rejectedCount Int                    @default(0)
  reviews       QuestionnaireReview[]  @relation("SubmissionQuestionnaireReviews")
  challenge     Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reviewer      User?                  @relation("ReviewerQuestionnaireSubmissions", fields: [reviewerId], references: [id])
  user          User                   @relation("UserQuestionnaireSubmissions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([submittedAt])
}

model QuestionnaireReview {
  id           String             @id @default(cuid())
  submissionId String
  supervisorId String
  status       WorkReviewStatus   @default(TAKEN)
  verdict      ReviewVerdict?
  comment      String?            // причина отказа
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  submission   QuestionnaireSubmission @relation("SubmissionQuestionnaireReviews", fields: [submissionId], references: [id], onDelete: Cascade)
  supervisor   User               @relation("SupervisorQuestionnaireReviews", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([submissionId, supervisorId])
  @@index([submissionId])
  @@index([supervisorId])
  @@index([status])
}

model LessonChallenge {
  id          String    @id @default(cuid())
  challengeId String    @unique
  content     String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model LessonCompletion {
  id            String    @id @default(cuid())
  challengeId   String
  userId        String
  firstViewedAt DateTime  @default(now())
  lastViewedAt  DateTime  @updatedAt
  challenge     Challenge @relation("ChallengeLessonCompletions", fields: [challengeId], references: [id], onDelete: Cascade)
  user          User      @relation("UserLessonCompletions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId])
}

model ChallengeAttempt {
  id                      String        @id @default(cuid())
  challengeId             String
  userId                  String
  status                  AttemptStatus @default(IN_PROGRESS)
  passed                  Boolean?
  startedAt               DateTime?
  finishedAt              DateTime?
  selectedQuestionIndices Json?
  answers                 Json?
  score                   Int?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  challenge               Challenge     @relation(fields: [challengeId], references: [id])
  user                    User          @relation("UserChallengeAttempts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([status])
}

model ChallengeUserState {
  id           String    @id @default(cuid())
  challengeId  String
  userId       String
  attemptsLeft Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  user         User      @relation("UserChallengeStates", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model WorkSubmission {
  id            String       @id @default(cuid())
  challengeId   String
  userId        String
  videoUrl      String
  transcriptUrl String?
  status        WorkStatus   @default(SUBMITTED)
  submittedAt   DateTime     @default(now())
  reviewerId    String?
  approvedCount Int          @default(0)
  rejectedCount Int          @default(0)
  reviews       WorkReview[] @relation("SubmissionWorkReviews")
  challenge     Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reviewer      User?        @relation("ReviewerWorkSubmissions", fields: [reviewerId], references: [id])
  user          User         @relation("UserWorkSubmissions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model WorkReview {
  id           String           @id @default(cuid())
  submissionId String
  supervisorId String
  status       WorkReviewStatus @default(TAKEN)
  verdict      ReviewVerdict?
  comment      String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  submission   WorkSubmission   @relation("SubmissionWorkReviews", fields: [submissionId], references: [id], onDelete: Cascade)
  supervisor   User             @relation("SupervisorWorkReviews", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([submissionId, supervisorId])
  @@index([submissionId])
  @@index([supervisorId])
  @@index([status])
}

// Новая модель Award - отдельная таблица наград
model Award {
  id                    String             @id @default(cuid())
  name                  String
  type                  AwardType
  badgeUrl              String?
  certificateTemplateId String?
  awardText             String?
  explanationText       String?            @db.Text
  isPublic              Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  
  certifications        Certification[]
  certificationAwards   CertificationAward[]

  @@index([type])
  @@index([isPublic])
}

model Certification {
  id                    String                     @id @default(cuid())
  slug                  String                     @unique
  title                 String
  description           String?
  awardText             String?
  level                 Int?
  isActive              Boolean                    @default(true)
  order                 Int                        @default(0)
  awardId               String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  awards                CertificationAward[]
  requirements          CertificationRequirement[]
  award                 Award?                     @relation(fields: [awardId], references: [id], onDelete: SetNull)
  certificateTemplate   CertificateTemplate?       @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  certificateTemplateId String?

  @@index([slug])
  @@index([isActive])
  @@index([awardId])
  @@index([certificateTemplateId])
}

model CertificationRequirement {
  id              String        @id @default(cuid())
  certificationId String
  challengeId     String
  order           Int           @default(0)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  challenge       Challenge     @relation(fields: [challengeId], references: [id])

  @@index([certificationId])
  @@index([challengeId])
}

model CertificationAward {
  id              String         @id @default(cuid())
  certificationId String?
  userId          String
  awardId         String?
  awardedAt       DateTime       @default(now())
  certificateId   String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  award           Award?         @relation(fields: [awardId], references: [id], onDelete: SetNull)
  user            User           @relation("CertificationAwards", fields: [userId], references: [id], onDelete: Cascade)
  certificate     Certificate?   @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@unique([certificationId, userId])
  @@index([userId, certificationId, certificateId])
  @@index([certificationId])
  @@index([certificateId])
  @@index([awardId])
}

model OnboardingTip {
  id           String             @id @default(cuid())
  title        String
  message      String
  type         TipType
  pageUrl      String
  delaySeconds Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  dismissals   UserTipDismissal[]

  @@index([pageUrl])
  @@index([type])
  @@index([isActive])
}

model UserTipDismissal {
  id          String        @id @default(cuid())
  userId      String
  tipId       String
  dismissedAt DateTime      @default(now())
  tip         OnboardingTip @relation(fields: [tipId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipId])
  @@index([userId])
  @@index([tipId])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  amount       Int
  status       PaymentStatus @default(PENDING)
  provider     String        // "Tinkoff" или "YooKassa"
  providerId   String?       // PaymentId от Т-Банка
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentLinks PaymentLink[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaymentLink {
  id          String     @id @default(cuid())
  userId      String
  paymentId   String?    // связь с Payment.id
  amount      Int
  redirectUrl String
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paymentId])
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  amount       Int
  balanceAfter Int
  description  String
  paymentId    String?         @unique
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DialogStatus {
  ACTIVE
  WAITING
  ARCHIVED
}

enum PsychologistStatus {
  PENDING
  CANDIDATE
  ACTIVE
  REJECTED
  BLOCKED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REVISION
  DRAFT
}

enum DocumentType {
  ACADEMIC_EDUCATION
  PROFESSIONAL_TRAINING
  COURSE
  SUPPORTING_DOC
  LINK
  PHOTO
  OTHER
}

enum NotificationType {
  LEAD
  ARTICLE_APPROVED
  ARTICLE_REVISION
  PROFILE_APPROVED
  PROFILE_REJECTED
  DOCUMENT_VERIFIED
  REMINDER
  INFO
  CATALOG_PUBLISHED
  PHOTO_REJECTED
  DOCUMENT_REJECTED
  CERTIFICATION_PASSED
  WORK_REVIEWED
  QUESTIONNAIRE_REVIEWED
  MODERATOR_MESSAGE
}

enum LeadStatus {
  NEW
  ACCEPTED
  COMPLETED
}

enum LeadResolution {
  PSYCHOLOGIST_REJECTED
  NO_CONTACT
  NO_AGREEMENT
  CLIENT_DROPPED
  FREE_ONLY
  PAID_COMPLETED
}

enum ChallengeType {
  TEST
  WORK
  LESSON
  QUESTIONNAIRE
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum WorkStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
}

enum ReviewVerdict {
  APPROVED
  REJECTED
}

enum WorkReviewStatus {
  TAKEN
  COMPLETED
  CANCELLED
}

enum AwardType {
  CERTIFICATE
  BADGE
}

enum QuestionnaireStatus {
  IN_PROGRESS
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  EARNING
  ADJUSTMENT
}

enum TipType {
  TOAST
  MODAL
}

model SecretPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  description String?
  filePath  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

// resourceType: page / catalog 
model UserAccess {
  id           String   @id @default(cuid())
  userId       String
  resourceType String
  resourceId   String
  grantedBy    String
  grantedAt    DateTime @default(now())
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  metaData     Json     @default("{}") @db.Json

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([grantedBy])
}

model Key {
  id          String   @id @default(cuid())
  code        String   @unique
  actionsJson Json
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uses        KeyUse[]

  @@index([code])
  @@index([isActive])
}

model KeyUse {
  id        String   @id @default(cuid())
  keyId     String
  userId    String
  usedAt    DateTime @default(now())
  key       Key      @relation(fields: [keyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyId, userId])
  @@index([keyId])
  @@index([userId])
}

// Модели для генератора сертификатов
model CertificateTemplate {
  id            String   @id @default(cuid())
  name          String   // "Сертификат ПП-1"
  slug          String   @unique
  backgroundUrl String   // путь к фоновой картинке
  fieldsJson    Json     @default("{\"fields\":[],\"background\":{\"width\":0,\"height\":0}}") @db.Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  certificates  Certificate[]
  certifications Certification[]

  @@index([slug])
  @@index([isActive])
}

model Certificate {
  id               String             @id @default(cuid())
  templateId       String
  userId           String             // кому выдан
  dataJson         Json               @default("{}") @db.Json // заполненные значения полей
  imageUrl         String             // путь к сгенерированному PNG
  verificationCode String             @unique // 8 символов, проверочный код
  issuedAt         DateTime           @default(now())
  template         CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user             User               @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  certificationAwards CertificationAward[]

  @@index([templateId])
  @@index([userId])
  @@index([verificationCode])
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  userId      String
  amount      Int
  status      WithdrawalStatus @default(PENDING)
  moderatorId String?
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  
  user      User      @relation("user_withdrawal_requests", fields: [userId], references: [id], onDelete: Cascade)
  moderator User?     @relation("moderator_withdrawals", fields: [moderatorId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ConsentDocument {
  id          String   @id @default(cuid())
  version     String   // "1.0", "1.1", "2.0"
  documentUrl String?  // ссылка для отображения текста
  content     String   @db.Text  // сам текст политики
  validFrom   DateTime // дата действия версии
  isActive    Boolean  @default(false)  // текущая ли версия
  createdAt   DateTime @default(now())

  @@index([isActive])
  @@index([version])
}

model AccessLog {
  id        String   @id @default(cuid())
  sessionId String?
  userId    String?
  clientId  String?
  userType  String?  // "psychologist" / "client"
  eventType String   // "LOGIN_SUCCESS", "LOGIN_FAILED", "LOGOUT"
  emailHash String?
  ipAddress String
  userAgent String?
  reason    String?  // "user_not_found", "wrong_type", "expired_token", "consent_required"
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([clientId])
  @@index([emailHash])
  @@index([ipAddress])
}

// Rate limiting для защиты от brute-force атак
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique  // например: "login:email@example.com"
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
}
