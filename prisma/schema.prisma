generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique /// @encrypted
  emailHash             String?            @unique
  emailVerified         DateTime?
  fullName              String?
  isAdmin               Boolean            @default(false)
  isManager             Boolean            @default(false)
  isSupervisor          Boolean            @default(false)
  status                PsychologistStatus @default(PENDING)
  isPublished           Boolean            @default(false)
  slug                  String?            @unique
  gender                String?
  birthDate             DateTime?
  city                  String?
  workFormat            String?
  mainParadigm          String[]
  certificationLevel    Int                @default(0)
  firstDiplomaDate      DateTime?
  lastCertificationDate DateTime?
  shortBio              String?            @db.VarChar(400)
  longBio               String?
  price                 Int?
  contactInfo           String?            @db.VarChar(150)
  unsubscribed          Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  draftData             Json?              @default("{}") @db.Json
  hasUnpublishedChanges Boolean            @default(false)
  avatarUrl             String?
  freeSession           Int                @default(0)
  sortOrder             Int                @default(0)
  moderatedArticles     Article[]          @relation("ModeratedArticles")
  articles              Article[]          @relation("AuthorArticles")
  articleCredits        ArticleCredit[]
  documents             Document[]         @relation("user_documents")
  verifiedDocuments     Document[]         @relation("verifier_documents")
  moderatorRecords      ModerationRecord[] @relation("moderator_records")
  moderationRecords     ModerationRecord[] @relation("moderated_user")
  sessions              Session[]
  dialogs               Dialog[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  complaintsFrom        Complaint[] @relation("psychologist_complaints_from")
  complaintsTo          Complaint[] @relation("psychologist_complaints_to")
  leads                 Lead[]

  // Курсы
  courses      UserCourse[]
  courseKeys   CourseKeyUse[]

  // Сертификация
  certificationAwards CertificationAward[] @relation(name: "CertificationAwards")
  challengeAttempts ChallengeAttempt[] @relation(name: "UserChallengeAttempts")
  challengeStates ChallengeUserState[] @relation(name: "UserChallengeStates")

  @@index([email])
  @@index([status])
  @@index([isPublished])
  @@index([city])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model Article {
  id               String           @id @default(cuid())
  title            String
  content          String
  excerpt          String?
  slug             String           @unique
  image            String?
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  userId           String?
  moderatedAt      DateTime?
  moderatedBy      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tags             String[]         @default([])
  moderatorComment String?
  submittedAt      DateTime?
  moderationStatus ModerationStatus @default(DRAFT)
  moderator        User?            @relation("ModeratedArticles", fields: [moderatedBy], references: [id])
  user             User?            @relation("AuthorArticles", fields: [userId], references: [id])
  credits          ArticleCredit[]
  articleImages    ArticleImage[]

  @@index([userId])
  @@index([moderationStatus])
  @@index([isPublished])
}

model ArticleImage {
  id          String   @id @default(cuid())
  articleId   String
  url         String
  storagePath String
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleCredit {
  id           String   @id @default(cuid())
  userId       String
  articleId    String
  articleTitle String
  month        Int
  year         Int
  creditedAt   DateTime @default(now())
  approvedAt   DateTime
  moderatedBy  String?
  article      Article  @relation(fields: [articleId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
}

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  url          String
  filename     String
  mimeType     String
  size         Int
  description  String?
  userId       String
  verifiedAt   DateTime?
  verifiedBy   String?
  uploadedAt   DateTime     @default(now())
  organization String?
  programName  String?
  year         Int?
  user         User         @relation("user_documents", fields: [userId], references: [id], onDelete: Cascade)
  verifier     User?        @relation("verifier_documents", fields: [verifiedBy], references: [id])

  @@index([userId])
  @@index([type])
  @@index([verifiedAt])
}

model Blocks {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  content     String?
  description String?
  isActive    Boolean @default(true)
}

model ModerationRecord {
  id          String           @id @default(cuid())
  status      ModerationStatus
  comment     String?
  userId      String
  moderatorId String?
  createdAt   DateTime         @default(now())
  moderator   User?            @relation("moderator_records", fields: [moderatorId], references: [id])
  user        User             @relation("moderated_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([moderatorId])
}

enum DialogStatus {
  ACTIVE // требует ответа модератора
  WAITING // ждем ответа пользователя
  ARCHIVED // закрыт/архив
}

model Dialog {
  id            String       @id @default(cuid())
  userId        String       @unique // один диалог на пользователя
  status        DialogStatus @default(ACTIVE)
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  dialogId  String // связь с диалогом
  direction String // 'to_moder' или 'to_user'
  text      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  dialog Dialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)

  @@index([dialogId])
  @@index([createdAt])
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  adminTitle      String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  metaRobots      String?
  template        String
  content         String
  customHead      String?
  images          String[]
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model DataList {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  items     Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum PsychologistStatus {
  PENDING
  CANDIDATE
  ACTIVE
  REJECTED
  BLOCKED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REVISION
  DRAFT
}

enum DocumentType {
  ACADEMIC_EDUCATION
  PROFESSIONAL_TRAINING
  COURSE
  SUPPORTING_DOC
  LINK
  PHOTO
  OTHER
}

enum NotificationType {
  LEAD // заявка от клиента
  ARTICLE_APPROVED // статья одобрена
  ARTICLE_REVISION // статья на доработку
  PROFILE_APPROVED // профиль одобрен
  PROFILE_REJECTED // профиль отклонен
  DOCUMENT_VERIFIED // документ проверен
  REMINDER // напоминание о статье
  INFO // новости проекта
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  linkUrl    String?
  linkText   String?
  isRead     Boolean          @default(false)
  isArchived Boolean          @default(false)
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  metadata   Json?            @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  deviceType String?  // 'desktop', 'mobile', 'tablet'
  deviceOs   String?  // 'windows', 'macos', 'ios', 'android', 'linux'
  browser    String?  // 'chrome', 'safari', 'firefox', 'edge', 'other'
  userAgent  String?  // исходный User-Agent
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== МОДЕЛИ СИСТЕМЫ ЗАЯВОК ====================

model Client {
  id              String   @id @default(cuid())
  email           String   @unique // @encrypted
  emailHash       String?  @unique
  name            String?  // @encrypted
  phone           String?  // @encrypted
  telegram        String?  // @encrypted
  vk              String?  // @encrypted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Репутация (невидимая для клиента)
  complaintCount  Int      @default(0)
  isShadowBanned  Boolean  @default(false)

  leads           Lead[]
  complaintsFrom  Complaint[] @relation("client_complaints_from")
  complaintsTo    Complaint[] @relation("client_complaints_to")

  @@index([email])
  @@index([emailHash])
}

model Lead {
  id               String         @id @default(cuid())
  clientId         String
  psychologistId   String
  message          String?        @db.Text
  status           LeadStatus     @default(NEW)
  resolution       LeadResolution?
  statusChangedAt  DateTime?
  createdAt        DateTime       @default(now())
  viewedAt         DateTime?

  // Для подозрительных клиентов
  isSuspicious     Boolean        @default(false)
  suspiciousReason String?

  // IP адрес для ограничения заявок
  ipAddress        String?

  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psychologist     User           @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  complaints       Complaint[]

  @@index([clientId])
  @@index([psychologistId])
  @@index([status])
  @@index([createdAt])
}

model Complaint {
  id                 String   @id @default(cuid())
  fromType           String   // 'client' или 'psychologist'
  fromClientId       String?
  fromPsychologistId String?
  toClientId         String?
  toPsychologistId   String?
  reason             String
  description        String?  @db.Text
  leadId             String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
  resolvedBy         String?
  resolution         String?

  fromClient         Client?  @relation("client_complaints_from", fields: [fromClientId], references: [id])
  fromPsychologist   User?    @relation("psychologist_complaints_from", fields: [fromPsychologistId], references: [id])
  toClient           Client?  @relation("client_complaints_to", fields: [toClientId], references: [id])
  toPsychologist     User?    @relation("psychologist_complaints_to", fields: [toPsychologistId], references: [id])
  lead               Lead?    @relation(fields: [leadId], references: [id])

  @@index([fromType])
  @@index([toClientId])
  @@index([toPsychologistId])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  ACCEPTED
  COMPLETED
}

enum LeadResolution {
  PSYCHOLOGIST_REJECTED  // психолог отказал сразу
  NO_CONTACT             // не удалось связаться
  NO_AGREEMENT           // связались, но не договорились
  CLIENT_DROPPED         // договорились, клиент пропал
  FREE_ONLY              // только бесплатная сессия
  PAID_COMPLETED         // были платные сессии
}

// ==================== КУРСЫ ====================

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique          // "pp", "pm", "pa", "mak"
  title       String                    // "Психолог-практик"
  shortTitle  String                    // "ПП" — для бейджей
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments UserCourse[]
  keys        CourseKey[]
  challengeAccess CourseChallengeAccess[]

  @@index([slug])
}

// ==================== СВЯЗЬ ПОЛЬЗОВАТЕЛЬ-КУРС ====================

model UserCourse {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  status     String   // "enrolled" или "graduated"
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

// ==================== ПРОМОКОДЫ ====================

model CourseKey {
  id         String   @id @default(cuid())
  courseId   String
  key        String   @unique
  status     String   // "enrolled" или "graduated" — статус, который присваивается пользователю
  maxUses    Int      @default(1)       // 0 — без ограничений
  usedCount  Int      @default(0)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uses   CourseKeyUse[]

  @@index([key])
  @@index([courseId])
}

model CourseKeyUse {
  id         String   @id @default(cuid())
  keyId      String
  userId     String
  usedAt     DateTime @default(now())

  key  CourseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyId])
  @@index([userId])
}

// ==================== СВЯЗЬ КУРСОВ С ИСПЫТАНИЯМИ ====================

model CourseChallengeAccess {
  id          String   @id @default(cuid())
  courseId    String
  challengeId String
  status      String   // "enrolled" (ученик) или "graduated" (выпускник)
  order       Int      @default(0)

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([courseId, challengeId, status])
  @@index([courseId])
  @@index([challengeId])
}

// ==================== СИСТЕМА СЕРТИФИКАЦИИ И ТЕСТОВ ====================

enum ChallengeType {
  TEST
  WORK
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model Challenge {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String?
  type         ChallengeType
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  test         TestChallenge?
  work         WorkChallenge?
  requirements CertificationRequirement[]
  attempts     ChallengeAttempt[]
  userStates   ChallengeUserState[]
  courseAccess CourseChallengeAccess[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
}

model TestChallenge {
  id             String      @id @default(cuid())
  challengeId    String      @unique
  questionsPool  Json        // банк вопросов в формате JSON
  questionsCount Int         // сколько вопросов выбирается в тест
  passingScore   Int         // сколько правильных ответов нужно для сдачи
  timeLimit      Int?        // лимит времени в минутах (null = без лимита)
  freeAttempts   Int         @default(2)
  unlockPrice    Int?        // цена разблокировки в копейках (null = нельзя купить)

  challenge      Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model WorkChallenge {
  id              String    @id @default(cuid())
  challengeId     String    @unique
  requiredReviews Int       @default(1)
  reviewsToPass   Int       @default(1)
  reviewPrice     Int?

  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model ChallengeAttempt {
  id                    String        @id @default(cuid())
  challengeId           String
  userId                String
  status                AttemptStatus @default(IN_PROGRESS)
  passed                Boolean?
  startedAt             DateTime?
  finishedAt            DateTime?
  selectedQuestionIndices Json?       // индексы выбранных вопросов из пула
  answers               Json?         // ответы пользователя: { "0": [2], "1": [0,3] }
  score                 Int?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  challenge             Challenge     @relation(fields: [challengeId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserChallengeAttempts")

  @@index([challengeId])
  @@index([userId])
  @@index([status])
}

model ChallengeUserState {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  attemptsLeft Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserChallengeStates")

  @@unique([challengeId, userId])
  @@index([userId])
}

model Certification {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  level       Int?     // null = не повышает уровень, иначе новый уровень
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements CertificationRequirement[]
  awards       CertificationAward[]

  @@index([slug])
  @@index([isActive])
}

model CertificationRequirement {
  id              String   @id @default(cuid())
  certificationId String
  challengeId     String
  order           Int      @default(0)

  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  challenge       Challenge     @relation(fields: [challengeId], references: [id])

  @@index([certificationId])
  @@index([challengeId])
}

model CertificationAward {
  id              String   @id @default(cuid())
  certificationId String
  userId          String
  awardedAt       DateTime @default(now())

  certification   Certification @relation(fields: [certificationId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, name: "CertificationAwards")

  @@unique([certificationId, userId])
  @@index([userId])
  @@index([certificationId])
}
